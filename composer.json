{
    "name": "creode/wordpress-blocks",
    "description": "Block library and block development framework for WordPress blocks.",
    "type": "wordpress-muplugin",
    "authors": [
        {
            "name": "Creode Limited"
        }
    ],
    "require": {
        "composer/installers": "*"
    },
    "require-dev": {
        "rector/rector": "^2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Creode\\Blocks\\Utils\\Rector\\": "utils/rector/src"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
